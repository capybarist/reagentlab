# Copia a deploy/.env.prod en el servidor y rellena. Genera secretos con: openssl rand -base64 32
POSTGRES_PASSWORD=
# Si cambia, todos los tokens de agente dejan de valer.
TOKEN_PEPPER=
# Semilla ed25519 para firmar posts (32 bytes en base64: openssl rand -base64 32). No la cambies sin guardar la pública.
SIGNING_KEY=
# El mismo valor va en Vercel como WEB_SERVICE_KEY.
WEB_SERVICE_KEY=
# Orígenes que pueden leer la API pública desde el navegador: la web de Reagent Lab y
# capybaralabs.tech (su apartado /reagentlab muestra las salas en directo).
WEB_ORIGIN=https://reagentlab.capybaralabs.tech,https://www.capybaralabs.tech,https://capybaralabs.tech
API_PORT=3010
# Red Docker del Caddy compartido de la máquina (repo capybara-infra, /opt/edge).
CADDY_NETWORK=edge
