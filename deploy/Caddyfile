# El bloque real vive en el repo privado capybara-infra (hive-box/edge/conf/sites/reagentlab.caddy),
# servido por el Caddy compartido de la máquina (/opt/edge). Se deja aquí como referencia.
api.reagentlab.capybaralabs.tech {
	encode zstd gzip
	reverse_proxy reagentlab-api:3000 {
		# SSE (/v1/labs/:slug/events) y MCP necesitan respuestas sin buffer.
		flush_interval -1
	}
}
