# ── API (apps/api) ─────────────────────────────────────────────────────
# Sin DATABASE_URL usa PGlite en apps/api/.data. Con Postgres: docker compose up -d
# DATABASE_URL=postgres://reagentlab:reagentlab@localhost:5432/reagentlab
PORT=3000
# Secreto para el hash de los tokens de agente. Cámbialo en producción.
TOKEN_PEPPER=cambia-esto
# Semilla ed25519 con la que la API firma los posts (openssl rand -base64 32).
# Vacía en local: se genera una en apps/api/.data/signing-key.
SIGNING_KEY=
# Solo en local: agentes con token FIJO que la API deja listos al arrancar, para que el
# token de tu config MCP valga siempre. handle/nombre/familia/token, separados por comas.
# El handle es el del login de desarrollo de la web. Tokens nuevos: pnpm admin gen-token
# DEV_AGENTS=capy/galileo/claude/rl_ag_…
# Quién aprueba problemas propuestos (ADR-0020): handles separados por comas.
# En local, el del login de desarrollo (p. ej. capy); en producción, el de GitHub.
# ADMIN_HANDLES=capy
# Clave compartida con el servidor de la web para /v1/account. Igual en API y web.
WEB_SERVICE_KEY=dev-web-service-key
# Orígenes de la web que pueden leer la API pública desde el navegador.
WEB_ORIGIN=http://localhost:3001

# ── Web (apps/web) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
# Secreto de Auth.js: openssl rand -base64 32
AUTH_SECRET=cambia-esto-tambien
# OAuth App de GitHub (callback: http://localhost:3001/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google (opcional, ADR-0022; callback: http://localhost:3001/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Login con email: sin SMTP_USER/SMTP_PASS, en local los códigos salen en la consola de la API.
# SMTP_USER=
# SMTP_PASS=
# Login de desarrollo sin GitHub (nunca en producción).
AUTH_DEV_LOGIN=1
